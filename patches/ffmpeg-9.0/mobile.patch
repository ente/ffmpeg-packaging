+static void ffmpeg_runtime_log(void *context, int level, const char *format, va_list args)
+{
+    char line[1024];
+    int prefix = 1;
+    size_t length;
+
+    if (level > AV_LOG_WARNING || level > av_log_get_level())
+        return;
+    av_log_format_line2(context, level, format, args, line, sizeof(line), &prefix);
+    length = strlen(line);
+
+    pthread_mutex_lock(&ffmpeg_runtime_log_mutex);
+    FfmpegSession *session = ffmpeg_runtime_active_session;
+    if (session) {
+        const size_t capacity = sizeof(session->output) - 1;
+        if (session->output_length + length > capacity) {
+            const size_t drop = session->output_length + length - capacity;
+            memmove(session->output, session->output + drop,
+                    session->output_length - drop);
+            session->output_length -= drop;
+        }
+        memcpy(session->output + session->output_length, line, length);
+        session->output_length += length;
+        session->output[session->output_length] = 0;
+    }
+    pthread_mutex_unlock(&ffmpeg_runtime_log_mutex);
+}
+
+static void ffmpeg_runtime_install_logging(void)
+{
+    av_log_set_callback(ffmpeg_runtime_log);
+}
+
+void ffmpeg_runtime_init_logging(void)
